# Required: server-side Reactor key. Never expose this in browser code.
REACTOR_API_KEY=replace_with_your_reactor_api_key

# Optional but recommended: powers provenance-safe interpretation and prompt direction.
# EchoVault has a deterministic fallback when Claude is unavailable.
CLAUDE_API_KEY=replace_with_your_claude_api_key
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: override the public Base RPC endpoints if your deployment uses a provider.
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=
